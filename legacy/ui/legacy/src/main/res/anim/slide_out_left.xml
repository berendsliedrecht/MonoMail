<?xml version="1.0" encoding="utf-8"?>
<!-- MonoMail: zero-duration for e-ink; animated transitions ghost on e-ink refreshes. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="1.0"
        android:duration="0"
        />
</set>
