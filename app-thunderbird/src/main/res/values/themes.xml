<?xml version="1.0" encoding="utf-8"?>
<!-- MonoMail: all accent colors forced to pure black/white for e-ink, window
     animations disabled (e-ink refreshes ghost on animated transitions). -->
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="Theme.Thunderbird.Startup" parent="Theme2.Main.Startup">
        <!-- MonoMail: white splash with the envelope mark -->
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_app_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>
    </style>

    <style name="Theme.Thunderbird.Light" parent="Theme2.Thunderbird.Light">
        <item name="android:windowAnimationStyle">@null</item>

        <item name="actionModeCloseDrawable">@drawable/ic_close</item>
        <item name="actionBarPopupTheme">@style/Widget.App.ActionMode.PopupMenu</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.MonoMail.TitleLarge</item>

        <!-- Legacy styles -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <item name="iconStarColor">#000000</item>

        <item name="textColorPrimaryRecipientDropdown">@android:color/primary_text_light</item>
        <item name="textColorSecondaryRecipientDropdown">@android:color/secondary_text_light</item>

        <item name="messageListSwipeSelectColor">#000000</item>
        <item name="messageListSwipeToggleReadColor">#000000</item>
        <item name="messageListSwipeToggleStarColor">#000000</item>
        <item name="messageListSwipeArchiveColor">#000000</item>
        <item name="messageListSwipeDeleteColor">#000000</item>
        <item name="messageListSwipeSpamColor">#000000</item>
        <item name="messageListSwipeMoveColor">#000000</item>

        <item name="contactPictureFallbackDefaultBackgroundColor">#ff000000</item>
        <item name="contactPictureFallbackBackgroundColors">@array/contact_picture_fallback_background_colors_light</item>
        <item name="contactTokenBackgroundColor">#ffffff</item>
        <item name="tintColorBulletPointPositive">#000000</item>
        <item name="tintColorBulletPointNegative">#000000</item>
        <item name="tintColorBulletPointNeutral">#000000</item>

        <item name="openpgp_black">#000</item>
        <item name="openpgp_orange">#000</item>
        <item name="openpgp_red">#000</item>
        <item name="openpgp_green">#000</item>
        <item name="openpgp_blue">#000</item>
        <item name="openpgp_grey">#000</item>
        <item name="openpgp_dark_grey">#000</item>
    </style>

    <!-- MonoMail: dark theme intentionally identical to light; e-ink has no dark mode. -->
    <style name="Theme.Thunderbird.Dark" parent="Theme2.Thunderbird.Dark">
        <item name="android:windowAnimationStyle">@null</item>

        <item name="actionModeCloseDrawable">@drawable/ic_close</item>
        <item name="actionBarPopupTheme">@style/Widget.App.ActionMode.PopupMenu</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.MonoMail.TitleLarge</item>

        <!-- Legacy styles -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <item name="iconStarColor">#000000</item>

        <item name="textColorPrimaryRecipientDropdown">@android:color/primary_text_light</item>
        <item name="textColorSecondaryRecipientDropdown">@android:color/secondary_text_light</item>

        <item name="messageListSwipeSelectColor">#000000</item>
        <item name="messageListSwipeToggleReadColor">#000000</item>
        <item name="messageListSwipeToggleStarColor">#000000</item>
        <item name="messageListSwipeArchiveColor">#000000</item>
        <item name="messageListSwipeDeleteColor">#000000</item>
        <item name="messageListSwipeSpamColor">#000000</item>
        <item name="messageListSwipeMoveColor">#000000</item>

        <item name="contactTokenBackgroundColor">#ffffff</item>
        <item name="contactPictureFallbackDefaultBackgroundColor">#ff000000</item>
        <item name="contactPictureFallbackBackgroundColors">@array/contact_picture_fallback_background_colors_light</item>
        <item name="tintColorBulletPointPositive">#000000</item>
        <item name="tintColorBulletPointNegative">#000000</item>
        <item name="tintColorBulletPointNeutral">#000000</item>

        <item name="openpgp_black">#000</item>
        <item name="openpgp_orange">#000</item>
        <item name="openpgp_red">#000</item>
        <item name="openpgp_green">#000</item>
        <item name="openpgp_blue">#000</item>
        <item name="openpgp_grey">#000</item>
        <item name="openpgp_dark_grey">#000</item>
    </style>

    <style name="Theme.Thunderbird.Light.Dialog" parent="Theme.Thunderbird.Light" />
    <style name="Theme.Thunderbird.Dark.Dialog" parent="Theme.Thunderbird.Dark" />

    <style name="Theme.Thunderbird.Light.Dialog.Translucent" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>

        <item name="tintColorBulletPointPositive">#000000</item>
        <item name="tintColorBulletPointNegative">#000000</item>
        <item name="tintColorBulletPointNeutral">#000000</item>
    </style>

    <style name="Theme.Thunderbird.Dark.Dialog.Translucent" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>

        <item name="tintColorBulletPointPositive">#000000</item>
        <item name="tintColorBulletPointNegative">#000000</item>
        <item name="tintColorBulletPointNeutral">#000000</item>
    </style>

    <style name="Theme.Thunderbird.DayNight" parent="Theme.Thunderbird.Light" />
    <style name="Theme.Thunderbird.DayNight.Dialog" parent="Theme.Thunderbird.Light.Dialog" />
    <style name="Theme.Thunderbird.DayNight.Dialog.Translucent" parent="Theme.Thunderbird.Light.Dialog.Translucent" />
</resources>
